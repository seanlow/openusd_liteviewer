
#usda 1.0
(
    startTimeCode = 1
    endTimeCode = 24
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "AnimatedTriangle"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (2, 0, 0), (0, 2, 0)]

        double3 xformOp:translate.timeSamples = {
            1: (1, 2, 3),
            12: (6, 7, 8),
            24: (9, 10, 11)
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def SphereLight "ModernLight"
    {
        color3f inputs:color = (0.2, 0.4, 0.8)
        float inputs:intensity = 250
        float inputs:exposure = 1
    }

    def DomeLight "ModernEnvironment"
    {
        color3f inputs:color = (0.3, 0.5, 0.7)
        float inputs:intensity = 2
    }

    def Scope "Looks"
    {
        def Material "TestMaterial"
        {

            token outputs:surface.connect = </World/Looks/TestMaterial/PreviewSurface.outputs:surface>
            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.6, 0.9)
                float inputs:roughness = 0.35
                float inputs:metallic = 0.2
                token outputs:surface
            }
        }
    }
}
